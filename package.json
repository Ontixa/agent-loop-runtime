{
  "name": "agent-loop-runtime",
  "version": "0.1.0",
  "main": "dist/index.js",
  "bin": {
    "agentloop": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "tsconfig.json",
    "qwen-loop.config.example.json",
    "scripts/run-tests.mjs",
    "scripts/e2e-runtime-recovery.mjs",
    "scripts/demo-mission.mjs",
    "scripts/test-demo.mjs",
    "scripts/test-package.mjs",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "npx tsc",
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/e2e-runtime-recovery.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ontixa/agent-loop-runtime.git"
  },
  "keywords": [
    "coding-agent",
    "agent-runtime",
    "mission",
    "worktree",
    "headless",
    "qwen",
    "codex",
    "claude-code",
    "devin",
    "gemini-cli",
    "opencode",
    "aider"
  ],
  "author": "tang-vu",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ontixa/agent-loop-runtime/issues"
  },
  "homepage": "https://github.com/Ontixa/agent-loop-runtime#readme",
  "description": "Agent Loop Runtime — headless, safe, resumable execution engine for coding agents (Codex, Claude Code, Devin, Gemini CLI, Qwen Code, OpenCode, Aider, custom CLIs) under one mission, policy and recovery model.",
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ora": "^3.1.0"
  }
}
